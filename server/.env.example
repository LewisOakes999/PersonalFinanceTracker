# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# On a default Homebrew Postgres install the role is your macOS username with no password:
#   postgresql://YOUR_USERNAME@localhost:5432/finance_tracker?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public"

# Port the Express API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins (the Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"

# Secret used to sign auth tokens. Change this to a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"
