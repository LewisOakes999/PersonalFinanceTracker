# Production environment variables for the server.
# Copy to your host's secret/env settings — DO NOT commit a filled-in version.

# PostgreSQL connection string (managed DB — Render/Neon/Supabase provide this).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Long random secret for signing auth tokens. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX"

# Must be "production" so the server serves the built client and skips dev-only behaviour.
NODE_ENV="production"

# Port. Most hosts inject this automatically; the server falls back to 4000.
PORT=4000

# Allowed CORS origin(s), comma-separated. Only needed if the client is served
# from a DIFFERENT origin than the API. With this single-service setup the app
# and API share an origin, so CORS doesn't apply — set it to your domain anyway
# for safety, e.g. https://your-domain.com
CLIENT_ORIGIN="https://your-domain.com"

# Optional: absolute path to the built client if it isn't at ../client/dist
# relative to the compiled server. The Docker image sets this up for you.
# CLIENT_DIST="/app/client/dist"
